          "raw": "{\n  \"provider\": \"STRIPE\",\n  \"account\": \"account-token\",\n  \"amount\": 125.5,\n  \"currency\": \"USD\",\n  \"reference\": \"ORDER-STRIPE-1001\"\n}"
